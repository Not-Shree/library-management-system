# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored — never commit real secrets.
DB_URL=jdbc:postgresql://localhost:5432/library_db
DB_USERNAME=library_user
DB_PASSWORD=change_me
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=480
# Browser dev server, plus https://localhost for the Android app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost
APP_TIMEZONE=Asia/Kolkata
SERVER_PORT=8080
